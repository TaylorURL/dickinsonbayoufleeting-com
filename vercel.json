{
  "routes": [
    {
      "src": "^/static/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "^/(services|about|contact|terms|privacy)/?$",
      "dest": "/$1/index.html"
    },
    { "src": "^/$", "dest": "/index.html" },
    { "src": "^/.*$", "dest": "/404.html", "status": 404 }
  ]
}
