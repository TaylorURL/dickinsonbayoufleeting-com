    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.6.2",
    "react-scripts": "5.0.1",
    "tailwindcss": "^3.4.19"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "node scripts/start-bundle-after-paint.js && node scripts/build-jsonld.js && node scripts/stamp-sitemap.js && node scripts/prerender.js",
    "test": "react-scripts test --passWithNoTests",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src scripts api --max-warnings=0 && node scripts/check-spacing-scale.js",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" \"scripts/**/*.{js,jsx}\" \"api/**/*.js\" \"public/**/*.{html,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" \"scripts/**/*.{js,jsx}\" \"api/**/*.js\" \"public/**/*.{html,json}\" \"*.{json,md}\"",
    "eject": "react-scripts eject"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "svgo": "^2.8.3",
    "resolve-url-loader": "^5.0.0",
    "serialize-javascript": "^7.0.5",
    "underscore": "^1.13.8",
    "@tootallnate/once": "^2.0.1",
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "fast-uri": "^3.1.6",
    "qs": "^6.16.0",
    "eslint": {
      "js-yaml": "^4.3.2"
    },
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  }
